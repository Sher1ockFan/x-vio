+            return fail("gyro bias fit ill conditioned: min="+std::to_string(eig.eigenvalues().minCoeff())+
+                        " trace="+std::to_string(gyroH.trace())+" intervals="+std::to_string(segments.size()));
+        V3 step=gyroH.ldlt().solve(-gradient);
